# Optional. Without these the app works fully, with everything saved on the
# device. Add them to sync your phone and laptop through Supabase
# (https://supabase.com/dashboard → Project Settings → API), then run
# supabase/schema.sql once in that project's SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
